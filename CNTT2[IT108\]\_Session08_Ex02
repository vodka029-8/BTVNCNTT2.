3. Mã nguồn Python điều khiển máy bơm tự động
Đoạn code mẫu dưới đây đọc dữ liệu từ cảm biến và tự động kích hoạt chân GPIO nếu độ ẩm xuống dưới mức tiêu chuẩn:

Python
import Adafruit_DHT
import time

# Cấu hình loại cảm biến và chân GPIO kết nối
SENSOR = Adafruit_DHT.DHT22
DHT_PIN = 4  # Chân DATA kết nối với GPIO 4

print("Đang khởi động hệ thống giám sát độ ẩm trang trại Lan...")

try:
    while True:
        # Đọc độ ẩm và nhiệt độ từ cảm biến
        humidity, temperature = Adafruit_DHT.read_retry(SENSOR, DHT_PIN)
        
        if humidity is not None and temperature is not None:
            print(f"Nhiệt độ: {temperature:.1f}C | Độ ẩm: {humidity:.1f}%")
            
            # Kiểm tra ngưỡng độ ẩm (Dưới 70% sẽ bật máy bơm)
            if humidity < 70.0:
                print("[CẢNH BÁO] Độ ẩm thấp! Đang kích hoạt máy bơm nước...")
            else:
                print("[AN TOÀN] Độ ẩm đạt chuẩn. Hệ thống nghỉ ngơi.")
        else:
            print("Lỗi: Không thể đọc dữ liệu từ cảm biến. Kiểm tra lại kết nối!")
            
        time.sleep(5)

except KeyboardInterrupt:
    print("\nĐã dừng chương trình bởi người dùng.")
